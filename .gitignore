# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets -- any *.env file (wherever it lives), not just the literal .env,
# so a stray one like the old backend/app/api/api.env can't get staged by
# accident. .env.example is a template with no real secrets, kept tracked.
*.env
!.env.example

# OS
.DS_Store

# SQLite DB (seeded from the CSV at startup, not source of truth)
*.db
